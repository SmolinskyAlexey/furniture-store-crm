function showNotification(message, type = 'error') {

    // Удаляем существующие уведомления

    document.querySelectorAll('.notification').forEach(n => n.remove());

    const notification = document.createElement('div');

    notification.className = `notification notification-${type}`;

    const icons = {
        success: '✓',
        error: '⚠',
        info: 'ℹ',
        warning: '⚡'
    };

    notification.innerHTML = `
            <div class="notification-content notification-card-${type}">
                <span class="notification-icon">${icons[type] || icons.info}</span>
                <span class="notification-message">${message}</span>
                <button class="notification-close modal-close" onclick="this.parentElement.parentElement.remove()">×</button>
            </div>
        `;

    document.body.appendChild(notification);

    // Анимация появления

    requestAnimationFrame(() => {
        notification.classList.add('show');
    });

    // Автоудаление

    setTimeout(() => {
        notification.classList.add('hide');
        setTimeout(() => notification.remove(), 300);
    }, 4000);
}



// === Функция инициализации автокомплита для одного инпута ===
function initAutocomplete(input) {
    if (input.dataset.autocompleteInitialized === 'true') return;
    input.dataset.autocompleteInitialized = 'true';

    let dropdown = null;
    let selectedIndex = -1;
    let items = [];
    let xhr = null;

    // Создание dropdown
    function createDropdown() {
      if (dropdown) return dropdown;

      dropdown = document.createElement('ul');
      dropdown.className = 'autocomplete-dropdown';
      document.body.appendChild(dropdown);

      positionDropdown();
      return dropdown;
    }

    // Позиционирование
    function positionDropdown() {
      if (!dropdown) return;
      const rect = input.getBoundingClientRect();
      dropdown.style.width = rect.width + 'px';
      dropdown.style.left = rect.left + window.scrollX + 'px';
      dropdown.style.top = (rect.bottom + window.scrollY) + 'px';
    }

    function showDropdown() {
      if (!dropdown) createDropdown();
      dropdown.style.display = 'block';
      positionDropdown();
    }

    function hideDropdown() {
      if (dropdown) dropdown.style.display = 'none';
      selectedIndex = -1;
      items = [];
    }

    function renderItems(data) {
      if (!dropdown) createDropdown();
      dropdown.innerHTML = '';

      if (!data || data.length === 0) {
        const li = document.createElement('li');
        li.className = 'autocomplete-item';
        li.textContent = 'Ничего не найдено';
        li.style.color = '#999';
        li.style.cursor = 'default';
        dropdown.appendChild(li);
        showDropdown();
        return;
      }

      items = data;
      data.forEach((item, index) => {
        const li = document.createElement('li');
        li.className = 'autocomplete-item';
        li.textContent = typeof item === 'string' ? item : (item.value || item.name || item);
        li.dataset.index = index;

        li.addEventListener('click', () => {
          input.value = li.textContent;
          hideDropdown();
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });

        li.addEventListener('mouseenter', () => {
          selectItem(index);
        });

        dropdown.appendChild(li);
      });