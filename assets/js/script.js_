            </div>
        </div>
    `;      
    /**
     * 
     *  <!-- === 2. Конкретная смена === -->
                            <div style="flex:1; border-left: 1px solid #e5e5e5; padding-left:30px;">
                                <h4 style="margin-bottom:15px;">Конкретная смена</h4>
                                <div class="form-group">
