                                        <button type="button" class="quantity-btn" onclick="changeQuantity(${id}, 1)"
                                                title="Увеличить количество">+</button>
                                    </div>
                                    
                            </div>
                        </div>
                        
                        <div class="product-details"></div> 

                        
                    </div>
                    
                </div>

            </td>           
